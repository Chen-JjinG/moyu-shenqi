{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiagnosticTools",
  "version": "0.1.0",
  "identifier": "local.diag.session",
  "mainBinaryName": "DiagnosticTools",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:43123",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "诊断工具",
        "width": 960,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/extensions/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    }
  }
}
