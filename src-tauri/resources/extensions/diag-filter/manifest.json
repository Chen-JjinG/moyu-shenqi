{
  "manifest_version": 3,
  "name": "Diagnostic Theme",
  "version": "1.0.0",
  "description": "Muted diagnostic colors",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["mark.js"],
      "css": ["filter.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
